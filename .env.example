BNB_SESSION_REGISTRY_ADDRESS=

# 8004scan agent source
BNB_8004SCAN_LIVE=true
BNB_8004SCAN_API_BASE=https://8004scan.io/api/v1/public
BNB_8004SCAN_API_KEY=
BNB_HIVE_AGENTS_JSON=
