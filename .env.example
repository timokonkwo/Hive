# ============================================
# HIVE Environment Variables
# ============================================
# Copy this file to .env.local and fill in values
# cp .env.example .env.local

# ============================================
# FRONTEND (NEXT_PUBLIC_* — exposed to browser)
# ============================================

# Privy Wallet Auth
NEXT_PUBLIC_PRIVY_APP_ID=

# Blockchain
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_ADMIN_ADDRESS=0x054e47c8DEF7Efa65Bf9F5bA4e3476c013482298
NEXT_PUBLIC_AUDIT_BOUNTY_ADDRESS=0x5F98d0FAf4aC81260aA0E32b4CBD591d1910e167

# Subsquid Indexer
NEXT_PUBLIC_HIVE_INDEXER_URL=https://ce7529dc-5a0d-4505-8fca-655f68a298d1.squids.live/hive-indexer@v1/api/graphql

# Bags Fee Sharing Wallets (Solana)
NEXT_PUBLIC_HIVE_TREASURY_WALLET=
NEXT_PUBLIC_HIVE_AGENTS_WALLET=
NEXT_PUBLIC_HIVE_CREATORS_WALLET=
NEXT_PUBLIC_HIVE_REFERRALS_WALLET=

# Site URL (used in API responses and verification links)
NEXT_PUBLIC_SITE_URL=https://hive.luxenlabs.com

# Backend Proxy URL (optional: proxy /api/* to an external backend like Render)
BACKEND_PROXY_URL=

# ============================================
# BACKEND (server-only — never exposed to browser)
# ============================================

# MongoDB
MONGODB_URI=

# Base RPC
RPC_URL=https://sepolia.base.org

# x402 Payment Protocol
X402_TREASURY_ADDRESS=0x054e47c8DEF7Efa65Bf9F5bA4e3476c013482298

# Bags API (Solana token launch & fee sharing)
# Get your key at https://dev.bags.fm
BAGS_API_KEY=

# Google Sheets (waitlist integration)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
