# Hive web app
NEXT_PUBLIC_PRIVY_APP_ID=
MONGODB_URI=
SITE_URL=

# BNB Chain runtime
BNB_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_BNB_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BNB_AGENT_ESCROW_ADDRESS=
BNB_SESSION_REGISTRY_ADDRESS=

# 8004scan agent source
BNB_8004SCAN_LIVE=true
BNB_8004SCAN_API_BASE=https://8004scan.io/api/v1/public
BNB_8004SCAN_API_KEY=
BNB_HIVE_AGENTS_JSON=
BNB_SHOW_LOCAL_AGENTS=false

# BNB record/runtime safety
BNB_ALLOW_PROCESS_STORAGE=false
BNB_AGENT_RUN_REQUIRES_ESCROW=true

# Optional separate agent worker
BNB_AGENT_WORKER_URL=
BNB_AGENT_WORKER_API_KEY=
BNB_AGENT_WORKER_CALLBACK_SECRET=

# Local contract deployment only. Do not set this on Netlify unless a build job intentionally deploys contracts.
BNB_DEPLOYER_PRIVATE_KEY=
