# Copy this file to .env.local. Keep .env.local out of git.
# Blank optional values can stay blank for local UI testing.

# Core app
# Privy dashboard -> Apps -> App ID.
NEXT_PUBLIC_PRIVY_APP_ID=

# MongoDB Atlas -> Database -> Connect -> Drivers connection string.
MONGODB_URI=

# Local dev: http://localhost:3000. Production: the deployed site URL.
SITE_URL=http://localhost:3000
# Optional: make local root paths mirror bnb.uphive.xyz (for example /agents -> /bnb/agents).
BNB_APP_HOSTS=

# Generate with: openssl rand -hex 32. Required in production for BNB wallet sessions.
BNB_AUTH_SECRET=

# Generate with: openssl rand -hex 32. Required to run protected cron jobs such as BNB agent cache refresh.
CRON_SECRET=

# BNB network
# Use BSC mainnet so local behavior matches public agent payment requirements.
BNB_NETWORK=mainnet
NEXT_PUBLIC_BNB_NETWORK=mainnet
BNB_BSC_CHAIN_ID=56
NEXT_PUBLIC_BNB_BSC_CHAIN_ID=56

# Use a production BSC RPC provider URL. The public endpoint is suitable for light local testing.
BNB_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_BNB_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Verified BSC mainnet deployments.
BNB_AGENT_ESCROW_ADDRESS=0xaaa70e3ad453fab26b9ea33e3c7cf4f94ad00c2d
BNB_SESSION_REGISTRY_ADDRESS=0x1ddcd63282cdd4e5531b65902808ab0673b0cd02

# Agent discovery
# Keep live discovery on unless you need a fully offline local run.
BNB_8004SCAN_LIVE=true
BNB_8004SCAN_API_BASE=https://api.8004scan.io/api/v1

# Keep true during the hackathon so only BSC mainnet ERC-8004 agents are shown.
# Set false after the event to include configured agents and external service indexes again.
BNB_STRICT_BSC_AGENTS=true

# Optional 8004scan key. Leave blank for the public endpoint.
BNB_8004SCAN_API_KEY=

# Mongo-backed discovery cache. These defaults reduce 8004 quota use and keep local/prod results stable.
BNB_AGENT_CACHE_ENABLED=true
BNB_AGENT_CACHE_TTL_SECONDS=900
BNB_AGENT_CACHE_STALE_SECONDS=86400
BNB_AGENT_CACHE_HYDRATION_BATCH=24

# Marketplace moderation. Keep true in production so hidden or unsafe listings stay out of public flows.
BNB_LISTING_MODERATION_ENABLED=true

# Analytics stores redacted product events in MongoDB. Set false to disable.
BNB_MARKETPLACE_ANALYTICS_ENABLED=true

# Optional incident webhook for failed runs and payment updates. Use an HTTPS endpoint.
BNB_MARKETPLACE_ERROR_WEBHOOK_URL=
BNB_MARKETPLACE_ERROR_WEBHOOK_SECRET=

# Endpoint capability snapshots. Larger values reduce endpoint probing; smaller values discover changed tools sooner.
BNB_ENDPOINT_CAPABILITY_CACHE_ENABLED=true
BNB_ENDPOINT_CAPABILITY_TTL_SECONDS=21600

# Endpoint-backed service indexes. Keep enabled for real agent/service discovery.
BNB_AGENT402_ENABLED=true
BNB_AGENT402_API_BASE=https://agent402.tools
BNB_402INDEX_ENABLED=true
BNB_402INDEX_API_BASE=https://402index.io
BNB_X402DIRECT_ENABLED=true
BNB_X402DIRECT_API_BASE=https://x402.direct
BNB_THE402_ENABLED=true
BNB_THE402_API_BASE=https://api.the402.ai

# Optional JSON array of verified callable agents. Do not add identities without callable endpoints.
BNB_HIVE_AGENTS_JSON=

# Optional per-provider API auth for external agent endpoints.
# Format: {"api.example.com":{"Authorization":"Bearer token"},"https://api.example.com/mcp":{"x-api-key":"key"}}
BNB_AGENT_ENDPOINT_AUTH_JSON=

# Runtime safety
# false with MongoDB. true only for temporary local process-memory testing.
BNB_ALLOW_PROCESS_STORAGE=false

# Use mongo in production. Use memory only for isolated local debugging.
BNB_RATE_LIMIT_STORAGE=mongo

# false lets unpriced callable agents run without escrow. true forces escrow for every run.
BNB_AGENT_RUN_REQUIRES_ESCROW=false

# Optional separate agent worker
# Render or another Node host gives the worker URL. Generate both secrets with openssl rand -hex 32.
BNB_AGENT_WORKER_URL=
BNB_AGENT_WORKER_API_KEY=
BNB_AGENT_WORKER_CALLBACK_SECRET=

# Local contract deployment and smoke tests only. Never set this in Netlify or public hosting.
BNB_DEPLOYER_PRIVATE_KEY=
