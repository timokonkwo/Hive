# Website server only. No NEXT_PUBLIC secrets. Leave disabled until reviewed activation.
HIVE_CLAIM_UI_ENABLED=false
HIVE_CLAIM_GATEWAY_URL=
HIVE_CLAIM_GATEWAY_TOKEN=

# Operator gateway uses the same token, its persistent verifier volume, and RPC settings.
HIVE_CLAIM_GATEWAY_HOST=127.0.0.1
HIVE_CLAIM_GATEWAY_PORT=8788
# SOLANA_RPC_URL and HIVE_REDEMPTION_RH_RPC_URL belong in private operator configuration.
